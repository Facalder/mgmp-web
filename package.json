{
    "name": "mgmp-web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check",
        "typecheck": "tsc --noEmit",
        "format:check": "bunx --bun @biomejs/biome check",
        "format:fix": "bunx --bun @biomejs/biome check --write",
        "check": "bun run typecheck && bun run format:check",
        "prepare": "husky"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@phosphor-icons/react": "^2.1.10",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.21.0",
        "next": "16.2.9",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "shadcn": "^4.11.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,css}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.0",
        "@commitlint/cli": "^21.1.0",
        "@commitlint/config-conventional": "^21.1.0",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "babel-plugin-react-compiler": "1.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
    ]
}
